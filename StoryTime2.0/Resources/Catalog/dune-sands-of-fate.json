      "choices": [
        {
          "text": "Choose the smallest war",
          "consequence": "Mercy.",
          "nextNodeId": "s6"
        },
        {
          "text": "Choose the swiftest justice",
          "consequence": "Anger.",
          "nextNodeId": "s6"
        }
