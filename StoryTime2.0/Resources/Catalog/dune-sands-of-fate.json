      "choices": [],
      "isEnding": true,
      "endingTitle": "Holy War"
    },
    {
      "id": "end_steward",
      "text": "You refuse the crown. A council rules. Stilgar leads the desert. You marry Chani in a cave. The empire shrinks; the people breathe.",
