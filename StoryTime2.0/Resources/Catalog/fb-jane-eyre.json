      "choices": [],
      "isEnding": true,
      "endingTitle": "A School of Her Own"
    },
    {
      "id": "end_writer",
      "text": "You write a book under another name. It is, in places, your life. It is, in many homes, kept on a shelf at the level of the eye.",
