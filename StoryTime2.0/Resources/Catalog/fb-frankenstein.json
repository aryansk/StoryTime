      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "end_pyre",
      "text": "He burns himself in the dark. Walton's ship turns home. You are buried at sea, or in ice, or in a story that gets told.",
      "sceneTitle": "The Pyre",
      "choices": [],
      "isEnding": true,
      "endingTitle": "The Pyre"
    },
    {
      "id": "end_walton",
      "text": "Walton writes the story honestly. The letter, eventually, becomes the book. Sisters read it by lamps. Generations read it after.",
      "sceneTitle": "Walton's Letter",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Walton's Letter"
    },
    {
      "id": "end_creature",
      "text": "Some say he lives still, on a far island, with cold seas around him. He writes, slowly, on stones, with charcoal. He is, in his way, also an author.",
      "sceneTitle": "The Creature, Lost",
      "choices": [],
      "isEnding": true,
