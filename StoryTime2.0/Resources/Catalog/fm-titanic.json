      "choices": [
        {
          "text": "Dance",
          "consequence": "Joy.",
          "nextNodeId": "s7"
        },
        {
          "text": "Sit and watch",
          "consequence": "Quiet.",
          "nextNodeId": "s7"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s7",
      "text": "Cal flips the table. He hits you, almost. You realize you cannot marry him.",
      "sceneTitle": "Cal's Anger",
      "choices": [
        {
          "text": "Decide now",
          "consequence": "Brave.",
          "nextNodeId": "s8"
        },
        {
          "text": "Decide later",
          "consequence": "Strategic.",
          "nextNodeId": "s8"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s8",
      "text": "Jack draws you wearing only the Heart of the Ocean. Cal will find the sketch.",
      "sceneTitle": "The Sketch",
      "choices": [
        {
          "text": "Hide it",
          "consequence": "Wise.",
          "nextNodeId": "s9"
        },
        {
          "text": "Leave it for him",
