  "nodes": [
    {
      "id": "s1",
      "text": "The biggest ship ever built. White Star flags. You don't look at it the way the steerage does.",
      "sceneTitle": "Boarding",
      "choices": [
        {
          "text": "Try to feel the wonder",
          "consequence": "Honest.",
          "nextNodeId": "s2"
        },
        {
          "text": "Stay composed",
          "consequence": "Class.",
          "nextNodeId": "s2"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s2",
      "text": "Your fiancé's smile is, on closer reading, ownership.",
      "sceneTitle": "Cal",
      "choices": [
        {
          "text": "Tolerate",
          "consequence": "Survive.",
          "nextNodeId": "s3"
        },
        {
          "text": "Push back",
          "consequence": "Spirit.",
          "nextNodeId": "s3"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s3",
      "text": "The first-class dining room is a circus of forks.",
      "sceneTitle": "Dinner",
      "choices": [
        {
          "text": "Be charming",
          "consequence": "Strategy.",
          "nextNodeId": "s4"
        },
        {
          "text": "Be honest",
          "consequence": "Truth.",
          "nextNodeId": "s4"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s4",
      "text": "You walk to the back at night, considering the water.",
      "sceneTitle": "The Stern",
      "choices": [
        {
          "text": "Climb the rail",
          "consequence": "Honest.",
          "nextNodeId": "s5"
        },
        {
          "text": "Step back",
          "consequence": "Caution.",
          "nextNodeId": "s5"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s5",
      "text": "A man named Jack talks you back from the rail. He sketches.",
      "sceneTitle": "Jack",
      "choices": [
        {
          "text": "Talk to him",
          "consequence": "Curious.",
          "nextNodeId": "s6"
        },
        {
          "text": "Walk away",
          "consequence": "Class.",
          "nextNodeId": "s6"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s6",
      "text": "Beer, music, dancing without shoes.",
