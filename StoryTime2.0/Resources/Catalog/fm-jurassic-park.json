      "choices": [
        {
          "text": "Make conversation",
          "consequence": "Care.",
          "nextNodeId": "s4"
        },
        {
          "text": "Watch the road",
          "consequence": "Cautious.",
          "nextNodeId": "s4"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s4",
      "text": "The sky opens. A goat is offered. The T. rex does not appear.",
