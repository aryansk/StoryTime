      "choices": [
        {
          "text": "Wait",
          "consequence": "Honest.",
          "nextNodeId": "s5"
        },
        {
          "text": "Volunteer to look",
          "consequence": "Brave.",
          "nextNodeId": "s5"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s5",
      "text": "The fences go dark. The T. rex notices. The car splits in half.",
      "sceneTitle": "Power Off",
      "choices": [
        {
          "text": "Run",
          "consequence": "Survive.",
          "nextNodeId": "s6"
        },
        {
          "text": "Stand still",
          "consequence": "Smart.",
          "nextNodeId": "s6"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s6",
      "text": "Up a tree, with Tim, with the broken car above you.",
