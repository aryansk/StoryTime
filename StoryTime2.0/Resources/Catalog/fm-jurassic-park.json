      "choices": [
        {
          "text": "Climb down",
          "consequence": "Brave.",
          "nextNodeId": "s7"
        },
        {
          "text": "Stay up",
          "consequence": "Wise.",
          "nextNodeId": "s7"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s7",
      "text": "Search and rescue. Muldoon has a gun. Ellie has a flashlight.",
      "sceneTitle": "Ellie and Muldoon",
      "choices": [
        {
          "text": "Help them search",
          "consequence": "Right.",
          "nextNodeId": "s8"
        },
        {
          "text": "Find the kids",
          "consequence": "Heart.",
          "nextNodeId": "s8"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s8",
      "text": "Ellie crouches by it, hand on the hide.",
      "sceneTitle": "Sick Triceratops",
      "choices": [
        {
          "text": "Help her diagnose",
          "consequence": "Science.",
          "nextNodeId": "s9"
        },
        {
          "text": "Watch the trees",
          "consequence": "Cautious.",
          "nextNodeId": "s9"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s9",
      "text": "Ice cream melts on the table. Hammond, smaller.",
