  "nodes": [
    {
      "id": "s1",
      "text": "You and Ellie arrive. Hammond grins. A brachiosaurus stands beyond the trees.",
      "sceneTitle": "Helicopter",
      "choices": [
        {
          "text": "Marvel",
          "consequence": "Joy.",
          "nextNodeId": "s2"
        },
        {
          "text": "Ask how",
          "consequence": "Scientist.",
          "nextNodeId": "s2"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s2",
      "text": "Vials, amber, frogs filling gaps in DNA.",
      "sceneTitle": "The Lab",
      "choices": [
        {
          "text": "Object on principle",
          "consequence": "Honest.",
          "nextNodeId": "s3"
        },
        {
          "text": "Reserve judgement",
          "consequence": "Civil.",
          "nextNodeId": "s3"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s3",
      "text": "Self-driving Jeeps. Lex and Tim in the back.",
