        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s2",
      "text": "You tell Ashley you love him. Rhett, behind the couch, hears.",
      "sceneTitle": "The Library",
      "choices": [
        {
          "text": "Slap him",
          "consequence": "Spirit.",
          "nextNodeId": "s3"
        },
        {
