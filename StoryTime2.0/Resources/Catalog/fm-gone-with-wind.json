      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s7",
      "text": "Rhett finds a wagon. He drives you out of the city.",
      "sceneTitle": "The Burning",
      "choices": [
        {
          "text": "Trust him",
          "consequence": "Path.",
          "nextNodeId": "s8"
        },
        {
          "text": "Argue",
          "consequence": "Spirit.",
          "nextNodeId": "s8"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s8",
      "text": "He leaves you to join the army. You drive on alone.",
      "sceneTitle": "The Road",
      "choices": [
        {
          "text": "Be furious",
          "consequence": "Spirit.",
          "nextNodeId": "s9"
        },
        {
          "text": "Be grateful",
          "consequence": "Honest.",
          "nextNodeId": "s9"
        }
