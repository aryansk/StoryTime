          "nextNodeId": "end_self"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "end_tara",
      "text": "You return to Tara. You rebuild. You become, in time, the woman the town respects more than likes. You die at Tara, ancient, in a field full of tomorrows.",
      "sceneTitle": "Tara, Again",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Tara, Again"
    },
    {
      "id": "end_rhett",
      "text": "You find Rhett, eventually. You apologize properly. He, slowly, comes around. You live, in the end, what you should have been living all along.",
      "sceneTitle": "Bringing Him Back",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Bringing Him Back"
    },
    {
      "id": "end_self",
      "text": "You build a business. You travel. You marry, late, a man who is, finally, not a project. You realize at sixty you were trying to win an argument with a younger version of yourself. You forgive her. You forgive everyone.",
      "sceneTitle": "Yourself, Finally",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Yourself, Finally"
    }
