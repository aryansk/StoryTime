          "nextNodeId": "s10"
        },
        {
          "text": "Mourn",
          "consequence": "Honest.",
          "nextNodeId": "s10"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s10",
      "text": "You eat a radish in the field. As God is your witness.",
