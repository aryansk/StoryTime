          "nextNodeId": "s14"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s14",
      "text": "He proposes. You accept for security.",
      "sceneTitle": "Rhett, Returning",
      "choices": [
        {
          "text": "Marry him",
          "consequence": "Practical.",
          "nextNodeId": "s15"
        },
        {
          "text": "Wait",
          "consequence": "Heart.",
          "nextNodeId": "s15"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s15",
      "text": "New Orleans. Lavish. He is, briefly, tender.",
      "sceneTitle": "Honeymoon",
      "choices": [
        {
          "text": "Notice",
          "consequence": "Honest.",
          "nextNodeId": "s16"
        },
        {
          "text": "Take it for granted",
          "consequence": "Spoiled.",
          "nextNodeId": "s16"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s16",
      "text": "Your daughter. He adores her.",
      "sceneTitle": "Bonnie",
      "choices": [
        {
          "text": "Love her",
          "consequence": "Heart.",
          "nextNodeId": "s17"
        },
        {
          "text": "Love her at distance",
          "consequence": "Honest.",
          "nextNodeId": "s17"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s17",
      "text": "You almost kiss him. Melanie defends you publicly to the town.",
      "sceneTitle": "Ashley, Again",
      "choices": [
        {
          "text": "Apologize to Melanie",
          "consequence": "Honor.",
          "nextNodeId": "s18"
        },
        {
          "text": "Stay silent",
          "consequence": "Pride.",
