      "sceneTitle": "Bonnie's Death",
      "choices": [
        {
          "text": "Comfort him",
          "consequence": "Honor.",
          "nextNodeId": "s19"
        },
        {
          "text": "Sit with your grief",
          "consequence": "Honest.",
          "nextNodeId": "s19"
        }
