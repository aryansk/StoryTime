    {
      "id": "s1",
      "text": "Barbecue. Ashley announces his engagement to Melanie.",
      "sceneTitle": "Twelve Oaks",
      "choices": [
        {
          "text": "Confront Ashley",
          "consequence": "Spirit.",
          "nextNodeId": "s2"
