      "choices": [
        {
          "text": "Promise",
          "consequence": "Honor.",
          "nextNodeId": "s20"
        },
        {
          "text": "Don't promise",
          "consequence": "Honest.",
          "nextNodeId": "s20"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s20",
      "text": "Ashley, holding Melanie's hand, weeps for Melanie, not you.",
      "sceneTitle": "Ashley's Truth",
      "choices": [
        {
          "text": "See clearly",
          "consequence": "Truth.",
          "nextNodeId": "s21"
        },
        {
          "text": "Look away",
          "consequence": "Honest.",
          "nextNodeId": "s21"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s21",
      "text": "Frankly, my dear, he does not give a damn.",
      "sceneTitle": "Rhett Leaving",
      "choices": [
        {
          "text": "Beg him",
          "consequence": "Spirit.",
          "nextNodeId": "end_tara"
        },
        {
          "text": "Let him go",
          "consequence": "Pride.",
          "nextNodeId": "end_rhett"
