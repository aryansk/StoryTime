      "choices": [
        {
          "text": "Vow",
          "consequence": "Iron.",
          "nextNodeId": "s11"
        },
        {
          "text": "Promise yourself smaller things",
          "consequence": "Honest.",
          "nextNodeId": "s11"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s11",
      "text": "You marry your sister's fiancé to save Tara.",
      "sceneTitle": "Frank Kennedy",
      "choices": [
        {
          "text": "Run the lumber business",
          "consequence": "Iron.",
          "nextNodeId": "s12"
        },
        {
          "text": "Pretend to be a wife",
          "consequence": "Cover.",
          "nextNodeId": "s12"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
