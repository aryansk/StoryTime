          "consequence": "Pride.",
          "nextNodeId": "s3"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s3",
      "text": "He bows. He says you're not a lady. He has noticed you.",
      "sceneTitle": "Rhett",
      "choices": [
        {
          "text": "Snap back",
          "consequence": "Spirit.",
          "nextNodeId": "s4"
        },
        {
          "text": "Walk away",
          "consequence": "Pride.",
          "nextNodeId": "s4"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s4",
      "text": "You marry Charles to spite Ashley. Charles dies of pneumonia.",
      "sceneTitle": "Charles",
      "choices": [
        {
          "text": "Mourn correctly",
          "consequence": "Society.",
          "nextNodeId": "s5"
        },
        {
          "text": "Skip mourning",
          "consequence": "Honest.",
          "nextNodeId": "s5"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s5",
      "text": "You move to Atlanta. The hospitals fill. Rhett finds you again.",
      "sceneTitle": "Atlanta",
      "choices": [
        {
          "text": "Dance with him at the bazaar",
          "consequence": "Spirit.",
          "nextNodeId": "s6"
        },
        {
          "text": "Refuse",
          "consequence": "Honor.",
          "nextNodeId": "s6"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s6",
      "text": "Yankees near. Atlanta burns. You deliver Melanie's baby.",
      "sceneTitle": "Melanie, in Labor",
      "choices": [
        {
          "text": "Stay with her",
          "consequence": "Honor.",
          "nextNodeId": "s7"
        },
        {
          "text": "Try to flee",
