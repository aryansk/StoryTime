  "nodes": [
    {
      "id": "s1",
      "text": "Wampa tracks in the snow, and the sun going down fast.",
      "sceneTitle": "Hoth Patrol",
      "choices": [
        {
          "text": "Investigate",
          "consequence": "Brave.",
          "nextNodeId": "s2"
        },
        {
          "text": "Report and return",
          "consequence": "Smart.",
          "nextNodeId": "s2"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s2",
      "text": "Probe droid spotted. The Empire is on the way.",
      "sceneTitle": "Echo Base Klaxon",
      "choices": [
        {
          "text": "Evacuate first",
          "consequence": "Care.",
          "nextNodeId": "s3"
        },
        {
          "text": "Hold the line",
          "consequence": "Soldier.",
          "nextNodeId": "s3"
        }
