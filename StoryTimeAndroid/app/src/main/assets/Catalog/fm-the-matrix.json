    {
      "id": "s1",
      "text": "A green prompt. Wake up, Neo. A knock at the door.",
      "sceneTitle": "The Apartment",
      "choices": [
        {
          "text": "Open",
          "consequence": "Brave.",
          "nextNodeId": "s2"
        },
        {
