    {
      "id": "end_one",
      "text": "You become a teacher and a target. You fly often. You also, occasionally, take the bus, because the bus passes a place that used to be your apartment.",
      "sceneTitle": "The One",
      "choices": [],
      "isEnding": true,
      "endingTitle": "The One"
    },
    {
      "id": "end_zion",
      "text": "You spend a decade rebuilding Zion's defenses. You marry Trinity. You retire, eventually, to teach kids how to fly. The kids, mostly, prefer running.",
      "sceneTitle": "Zion's Builder",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Zion's Builder"
    },
    {
      "id": "end_peace",
      "text": "You broker, eventually, a peace between humans and machines. The truce holds for a generation. After that, you don't know. You are, for now, content with a generation.",
