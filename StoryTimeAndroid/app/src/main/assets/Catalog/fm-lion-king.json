    {
      "id": "end_king",
      "text": "You rule for decades. The savanna heals. Songs are sung about you. Some of them, sweetly, are about Pumbaa.",
      "sceneTitle": "King",
      "choices": [],
      "isEnding": true,
      "endingTitle": "King"
    },
    {
      "id": "end_council",
      "text": "You build a council with hyenas at the table. The pride disagrees. The pride is, in the end, stronger for it.",
      "sceneTitle": "The Council",
      "choices": [],
      "isEnding": true,
      "endingTitle": "The Council"
    },
    {
      "id": "end_legacy",
      "text": "You die old. Your cub becomes the next ruler. They, in turn, raise their own. The circle, you decide, is exactly as small as it ever was. And exactly as wide.",
      "sceneTitle": "Circle",
