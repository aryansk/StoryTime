  "nodes": [
    {
      "id": "s1",
      "text": "José Arcadio Buendía draws Macondo on a map.",
      "sceneTitle": "Founding",
      "choices": [
        {
          "text": "Plant the trees",
          "consequence": "Path.",
          "nextNodeId": "s2"
