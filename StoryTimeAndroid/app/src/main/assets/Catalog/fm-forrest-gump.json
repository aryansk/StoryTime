      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s13",
      "text": "You and Dan start a shrimp company in Bubba's name. The hurricane spares your boat. You make a lot of money.",
      "sceneTitle": "Bubba Gump",
      "choices": [
        {
          "text": "Give half to Bubba's mama",
          "consequence": "Honor.",
          "nextNodeId": "s14"
        },
        {
          "text": "Save it all for Mama",
