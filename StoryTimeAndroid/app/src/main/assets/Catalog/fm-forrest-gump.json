      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s14",
      "text": "Mama is dying. You sit with her. She tells you life is a box of chocolates.",
      "sceneTitle": "Mama",
      "choices": [
        {
          "text": "Sit till the end",
          "consequence": "Son.",
          "nextNodeId": "s15"
        },
        {
          "text": "Promise her you'll be okay",
