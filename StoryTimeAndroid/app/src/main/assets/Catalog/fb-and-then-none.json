      "choices": [],
      "isEnding": true,
      "endingTitle": "The Bottle Surfaces"
    },
    {
      "id": "end_island",
      "text": "Soldier Island becomes a small ruin. Boats pass. Tourists come, sometimes, with a camera and a copy of the book.",
