          "consequence": "Honest.",
          "nextNodeId": "s4"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s4",
      "text": "A poet without a subject. He envies you, sort of.",
      "sceneTitle": "Helmholtz",
      "choices": [
        {
          "text": "Befriend him",
          "consequence": "Friend.",
          "nextNodeId": "s5"
        },
        {
          "text": "Be wary",
          "consequence": "Wise.",
          "nextNodeId": "s5"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s5",
      "text": "He bristles at orgy porgy. He smiles wrong.",
      "sceneTitle": "Bernard",
      "choices": [
        {
          "text": "Travel with him",
          "consequence": "Path.",
          "nextNodeId": "s6"
        },
        {
          "text": "Avoid him",
          "consequence": "Wise.",
          "nextNodeId": "s6"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s6",
      "text": "Savage land. Whips. A blue-eyed boy named John.",
      "sceneTitle": "Reservation",
      "choices": [
        {
          "text": "Bring John back",
          "consequence": "Path.",
          "nextNodeId": "s7"
        },
        {
          "text": "Leave him",
          "consequence": "Wise.",
          "nextNodeId": "s7"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s7",
      "text": "His mother, fat, soma-mad, ashamed.",
      "sceneTitle": "Linda",
      "choices": [
        {
          "text": "Bring her too",
          "consequence": "Care.",
          "nextNodeId": "s8"
        },
        {
          "text": "Leave her",
          "consequence": "Honest.",
          "nextNodeId": "s8"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
