    {
      "id": "s1",
      "text": "Decanting. Bokanovsky. The tourists nod.",
      "sceneTitle": "Hatchery Tour",
      "choices": [
        {
          "text": "Be a polite tourist",
          "consequence": "Civil.",
          "nextNodeId": "s2"
        },
