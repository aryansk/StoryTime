  "nodes": [
    {
      "id": "s1",
      "text": "You arrive to help your brother's marriage. A man dies under the train.",
      "sceneTitle": "Moscow Station",
      "choices": [
        {
          "text": "Note the omen",
          "consequence": "Honest.",
          "nextNodeId": "s2"
        },
        {
          "text": "Disregard",
          "consequence": "Survive.",
          "nextNodeId": "s2"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s2",
      "text": "He sees you and you see him. The room rearranges.",
      "sceneTitle": "Vronsky",
      "choices": [
        {
          "text": "Withdraw",
          "consequence": "Wise.",
          "nextNodeId": "s3"
        },
        {
          "text": "Stay",
          "consequence": "Honest.",
          "nextNodeId": "s3"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s3",
      "text": "Your husband, kind in a clerk's way, asks about your trip.",
      "sceneTitle": "Karenin",
      "choices": [
        {
          "text": "Tell him plainly",
          "consequence": "Honor.",
          "nextNodeId": "s4"
        },
        {
          "text": "Withhold",
          "consequence": "Honest.",
          "nextNodeId": "s4"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s4",
      "text": "Kitty wears white. You wear black. Vronsky chooses badly.",
      "sceneTitle": "Ball",
      "choices": [
        {
          "text": "Leave early",
          "consequence": "Wise.",
          "nextNodeId": "s5"
        },
        {
          "text": "Dance",
          "consequence": "Honest.",
          "nextNodeId": "s5"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s5",
      "text": "Your son is at the door. Seryozha hugs you.",
      "sceneTitle": "St. Petersburg",
      "choices": [
        {
          "text": "Hold him long",
          "consequence": "Mother.",
          "nextNodeId": "s6"
        },
        {
          "text": "Set him down quickly",
          "consequence": "Survive.",
          "nextNodeId": "s6"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s6",
      "text": "Vronsky's horse falls. You scream his name.",
      "sceneTitle": "Races",
      "choices": [
        {
          "text": "Recover the scream",
          "consequence": "Society.",
          "nextNodeId": "s7"
        },
        {
          "text": "Don't recover",
          "consequence": "Honest.",
          "nextNodeId": "s7"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s7",
      "text": "He gives you a choice — be a wife, or be cut off entirely.",
      "sceneTitle": "Karenin's Offer",
      "choices": [
        {
          "text": "Lie",
          "consequence": "Survive.",
          "nextNodeId": "s8"
        },
        {
          "text": "Tell the truth",
          "consequence": "Honor.",
          "nextNodeId": "s8"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s8",
      "text": "Vronsky and you, abroad. He paints. You are, for a month, free.",
      "sceneTitle": "Italy",
      "choices": [
        {
          "text": "Stay months",
          "consequence": "Heart.",
          "nextNodeId": "s9"
        },
        {
          "text": "Plan a return",
          "consequence": "Patient.",
          "nextNodeId": "s9"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s9",
      "text": "Your daughter. You do not love her the same way.",
      "sceneTitle": "Annie",
      "choices": [
        {
          "text": "Try",
          "consequence": "Honor.",
          "nextNodeId": "s10"
        },
        {
          "text": "Don't try",
          "consequence": "Honest.",
          "nextNodeId": "s10"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s10",
      "text": "Society has, in your absence, decided.",
      "sceneTitle": "Return to Russia",
      "choices": [
        {
          "text": "Visit Seryozha",
          "consequence": "Mother.",
          "nextNodeId": "s11"
        },
        {
          "text": "Avoid Seryozha",
          "consequence": "Wise.",
          "nextNodeId": "s11"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s11",
      "text": "He cries against your dress. You can't, by law, take him.",
      "sceneTitle": "Seryozha",
      "choices": [
        {
          "text": "Vow to find a way",
          "consequence": "Mother.",
          "nextNodeId": "s12"
        },
        {
          "text": "Pray",
          "consequence": "Wise.",
          "nextNodeId": "s12"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s12",
      "text": "A countess cuts you publicly.",
      "sceneTitle": "Salon",
      "choices": [
        {
          "text": "Hold your shoulders",
          "consequence": "Brave.",
          "nextNodeId": "s13"
        },
        {
          "text": "Leave",
          "consequence": "Wise.",
          "nextNodeId": "s13"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s13",
      "text": "Off-page, your brother-in-law marries. The country is, briefly, happy.",
      "sceneTitle": "Levin's Wedding",
      "choices": [
        {
          "text": "Send a gift",
          "consequence": "Civil.",
          "nextNodeId": "s14"
        },
        {
          "text": "Be still",
          "consequence": "Honest.",
          "nextNodeId": "s14"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s14",
      "text": "You begin to read Vronsky's mail.",
      "sceneTitle": "Jealousy",
      "choices": [
        {
          "text": "Stop",
          "consequence": "Wise.",
          "nextNodeId": "s15"
        },
        {
          "text": "Continue",
          "consequence": "Honest.",
          "nextNodeId": "s15"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s15",
      "text": "You take more, then more.",
      "sceneTitle": "Morphine",
      "choices": [
        {
          "text": "Cut back",
          "consequence": "Wise.",
          "nextNodeId": "s16"
        },
        {
          "text": "Take more",
          "consequence": "Honest.",
          "nextNodeId": "s16"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s16",
      "text": "He goes to Moscow. He writes a vague letter.",
      "sceneTitle": "Quarrel",
      "choices": [
        {
          "text": "Send a sharp one",
          "consequence": "Pride.",
          "nextNodeId": "s17"
        },
        {
          "text": "Send a soft one",
          "consequence": "Honest.",
          "nextNodeId": "s17"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s17",
      "text": "You ride into town to find him.",
      "sceneTitle": "Train Station, Again",
      "choices": [
        {
          "text": "Wait at the station for the next train",
          "consequence": "Honest.",
          "nextNodeId": "s18"
        },
        {
          "text": "Take a cab",
          "consequence": "Wise.",
          "nextNodeId": "s18"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s18",
      "text": "Faces blur. The bell. Your shawl is heavy.",
      "sceneTitle": "Platform",
      "choices": [
        {
          "text": "Step back",
          "consequence": "Save.",
          "nextNodeId": "s19"
        },
        {
          "text": "Step forward",
          "consequence": "Honest.",
          "nextNodeId": "s19"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s19",
      "text": "A man dies under the train. You can choose another ending.",
      "sceneTitle": "Bookend",
      "choices": [
        {
          "text": "Choose another",
          "consequence": "Save.",
          "nextNodeId": "s20"
        },
        {
          "text": "Step",
          "consequence": "Honest.",
          "nextNodeId": "s20"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s20",
      "text": "If you stepped back, you sit on a bench with shaking hands.",
      "sceneTitle": "After",
      "choices": [
        {
          "text": "Go home",
          "consequence": "Survive.",
          "nextNodeId": "s21"
        },
        {
          "text": "Leave Vronsky",
          "consequence": "Path.",
          "nextNodeId": "s21"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "s21",
      "text": "Far away, your brother-in-law in a hayfield finds peace. He thinks of you, sometimes.",
      "sceneTitle": "Levin's Field",
      "choices": [
        {
          "text": "Send him a letter",
          "consequence": "Honor.",
          "nextNodeId": "end_step"
        },
        {
          "text": "Don't send",
          "consequence": "Honest.",
          "nextNodeId": "end_step_back"
        },
        {
          "text": "Take the third path",
          "consequence": "Some endings reveal themselves last.",
          "nextNodeId": "end_levin"
        }
      ],
      "isEnding": false,
      "endingTitle": null
    },
    {
      "id": "end_step",
      "text": "You step. The book closes on you. Vronsky goes to a war and dies. Karenin raises Seryozha and Annie. Years pass.",
      "sceneTitle": "The Bell",
      "choices": [],
      "isEnding": true,
      "endingTitle": "The Bell"
    },
    {
      "id": "end_step_back",
      "text": "You step back. You move, alone, to Italy. You raise Annie in a small house. You read, late, that Vronsky has, in Serbia, found a war.",
      "sceneTitle": "Step Back",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Step Back"
    },
    {
      "id": "end_levin",
      "text": "Levin's chapter outlives yours. He raises his children. He thinks of you in a hayfield, every year, when the light is right. You exist, in him, as a small daily prayer.",
      "sceneTitle": "Levin's Field",
      "choices": [],
      "isEnding": true,
      "endingTitle": "Levin's Field"
    }
  ]
}
